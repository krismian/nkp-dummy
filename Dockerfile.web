FROM golang:1.23-alpine AS build

WORKDIR /src
COPY go.mod ./
COPY frontend ./frontend

ARG VERSION=dev
RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X main.version=${VERSION}" \
    -o /out/nkp-dummy-web ./frontend

FROM scratch

COPY --from=build /out/nkp-dummy-web /nkp-dummy-web

EXPOSE 8080
USER 65532:65532
ENTRYPOINT ["/nkp-dummy-web"]
